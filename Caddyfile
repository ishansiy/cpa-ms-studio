# CPA Stack 对外入口（ModelScope Docker Studio）
#
# 公网只暴露 7860，三个上游全在容器回环：
#   CLIProxyAPI  127.0.0.1:8317   推理网关
#   Oh My CPA    127.0.0.1:18901  控制台（base path /，即根路径）
#
# 路由规则：
#   /healthz, /v0/management*, /v0/resource/plugins/*, /v1*, /v1beta*
#       -> CPA 网关（API 与管理接口）
#   其余所有路径（含 / 与 SPA history 路由如 /settings、/usage）
#       -> Oh My CPA 控制台
#
# 请求头净化（ModelScope 国际版边缘会向容器注入/替换 Authorization，
# 实测见 grok2api-ms 的 authstrip 教训；此处按 CPA v8 的真实语义处理）：
#   - /v1*、/v1beta*（客户端 API）：删除 Authorization。CPA v8 的
#     access provider 原生匹配 X-Api-Key / X-Goog-Api-Key / ?key= /
#     ?auth_token=，因此客户端一律使用 X-Api-Key 或 ?key=（Bearer 经
#     ms.fun 本就会被边缘改写，不可依赖）。
#   - /v0/management*（管理 API）：删除 Authorization。CPA v8 管理中间件
#     原生接受 X-Management-Key，管理调用一律使用该头。
#   - 控制台路径：删除 Authorization。OMC 使用会话 Cookie 登录，
#     不接受请求头凭据；它自己持有 CPA 管理钥去连接网关。
#
# 控制台的 same-origin 校验（OMC 防 CSRF，internal/api/handler.go：
# 比较浏览器 Origin 的 host 与 request.Host、scheme 与
# TLS/X-Forwarded-Proto 推导值）的适配：
#   本链路 浏览器→CF→gateway Worker→ms.fun 边缘→容器 Caddy→OMC 中，
#   TLS 在 CF/网关层终止（Caddy→OMC 是明文 HTTP），且 ms.fun 边缘会把
#   Host 改写成容器内部地址（实测 host=....pai-eas.aliyuncs.com）、
#   并覆写 X-Forwarded-Host 为创空间自身主机名——浏览器原始入口域名
#   只存在于 Origin/Referer 头中（两者均原样透过边缘）。
#   因此：
#   - 对「我们自己的入口域名」的 Origin 做精确白名单匹配，并把发给
#     OMC 的 Host 重写为该入口域名，使校验按「真同源」通过；
#   - 强制 X-Forwarded-Proto: https（否则 OMC 推导的 scheme 是 http，
#     与浏览器 https 的 Origin 不符）；
#   - 不做「无条件跟随 Origin」的重写：那会把校验变成恒真、中和防
#     CSRF 能力。跨站攻击者的 Origin 不在白名单 → Host 保持边缘改写
#     的内部地址 → 校验依然拒绝。
#   - 新增入口域名时，在此增加对应的 @origin_* 匹配与 handle 块。
#
# 响应头：OMC 自带 X-Frame-Options: SAMEORIGIN（强制生效）与
# Report-Only 的 frame-ancestors 'self'，会让「魔塔平台创空间页」
# 以跨域 iframe 嵌入时被浏览器拒绝而白屏。故删除 XFO 并下发一条
# 强制的 frame-ancestors 白名单（仅允许魔塔自身域名内嵌）。

:7860 {

	encode gzip zstd

	# 网关健康检查（无鉴权需求）
	handle /healthz {
		reverse_proxy 127.0.0.1:8317
	}

	# CPA 管理接口：管理调用携带 X-Management-Key
	handle /v0/management* {
		reverse_proxy 127.0.0.1:8317 {
			header_up -Authorization
		}
	}

	# CPA 插件资源（OMC 面板内的可信插件页面）
	handle /v0/resource/plugins/* {
		reverse_proxy 127.0.0.1:8317 {
			header_up -Authorization
		}
	}

	# 客户端模型 API：OpenAI 兼容与 Gemini 兼容
	handle /v1* {
		reverse_proxy 127.0.0.1:8317 {
			header_up -Authorization
		}
	}

	handle /v1beta* {
		reverse_proxy 127.0.0.1:8317 {
			header_up -Authorization
		}
	}

	# Oh My CPA 控制台：根路径及所有 SPA 路由
	#
	# 白名单：仅当 Origin 精确等于我们自己的入口域名时重写 Host。
	route {
		@origin_cpa header Origin https://cpa.007666.xyz
		@origin_msf header Origin https://cpa11111-cpa-stack.ms.fun

		handle @origin_cpa {
			reverse_proxy 127.0.0.1:18901 {
				header_up -Authorization
				header_up X-Forwarded-Proto https
				header_up Host cpa.007666.xyz
			}
			header {
				-X-Frame-Options
				+Content-Security-Policy "frame-ancestors 'self' https://www.modelscope.ai https://modelscope.ai https://*.modelscope.ai https://*.ms.fun https://*.ms.show"
			}
		}

		handle @origin_msf {
			reverse_proxy 127.0.0.1:18901 {
				header_up -Authorization
				header_up X-Forwarded-Proto https
				header_up Host cpa11111-cpa-stack.ms.fun
			}
			header {
				-X-Frame-Options
				+Content-Security-Policy "frame-ancestors 'self' https://www.modelscope.ai https://modelscope.ai https://*.modelscope.ai https://*.ms.fun https://*.ms.show"
			}
		}

		# 其余情况（无 Origin 的 API 客户端 / 非白名单 Origin）：
		# 无 Origin 时 OMC 本就放行（非浏览器客户端）；非白名单 Origin
		# 保持 Host 原样，同源校验按设计拒绝。
		handle {
			reverse_proxy 127.0.0.1:18901 {
				header_up -Authorization
				header_up X-Forwarded-Proto https
			}
			header {
				-X-Frame-Options
				+Content-Security-Policy "frame-ancestors 'self' https://www.modelscope.ai https://modelscope.ai https://*.modelscope.ai https://*.ms.fun https://*.ms.show"
			}
		}
	}
}
